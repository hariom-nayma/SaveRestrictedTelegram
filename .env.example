# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Optional: Custom upload channel invite link, username, or ID (defaults to 'me' / Saved Messages)
UPLOAD_CHAT=

# Optional: Bot Token from @BotFather to enable interactive cloning with inline buttons
BOT_TOKEN=

# Optional: Max file size to download in MB (e.g. 500 for 500MB, 1500 for 1.5GB). Leave blank for unlimited.
MAX_FILE_SIZE_MB=
